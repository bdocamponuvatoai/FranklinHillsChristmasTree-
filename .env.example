# Canonical public URL used for metadata, Open Graph, sitemap and robots.txt.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search indexing is OFF by default (noindex meta, X-Robots-Tag header, robots.txt Disallow).
# Set to "enabled" only after the owner has confirmed address, hours, season dates and services.
SITE_INDEXING=disabled
